# 复制本文件为 .env 后填写。
# 留空 LLM_API_KEY 时，工具自动降级为「仅检索模式」，无需任何外部凭据即可演示。

# ---- LLM 配置（任意 OpenAI 兼容服务）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# 其他示例：
# DeepSeek : LLM_BASE_URL=https://api.deepseek.com         LLM_MODEL=deepseek-chat
# OpenAI   : LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# Ollama本地: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen2.5:7b

# ---- 分块参数 ----
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ---- 检索参数 ----
TOP_K=4

# ---- 数据目录（索引文件存放位置）----
# ANNOQA_DATA_DIR=data
